# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# NEVER commit the real `.env` file and NEVER put real secrets here.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Server-scoped connection string used by Prisma Migrate / Prisma Studio.
# Local development example:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/skill_certification?schema=public"

# --- Application secrets ---------------------------------------------------
# Secret used to sign session tokens (HMAC-SHA256 via `jose`).
# Generate a strong value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Rotating this invalidates every active session.
AUTH_SECRET="replace-with-a-random-64-character-secret"

# --- Session / cookie behaviour -------------------------------------------
# Session lifetime in seconds. Default 8 hours (28800).
SESSION_MAX_AGE="28800"

# Set to "true" when running behind HTTPS so the session cookie is only ever
# sent over an encrypted connection. Keep "false" for plain http://localhost.
COOKIE_SECURE="false"

# Optional: public base URL of the application. Used for absolute links
# (e.g. verification e-mails in later modules).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Module 2 — eKYC provider
# ---------------------------------------------------------------------------
# These are PLACEHOLDERS ONLY. Do not put real credentials in this file — it is
# committed. Real values belong in `.env` (git-ignored) or in your deployment
# platform's secret store.
#
# NOTHING here is configured yet, and that is a supported, intentional state.
# Until an authorised eKYC provider is selected and these values are supplied,
# the application reports "eKYC provider not configured" and refuses to start a
# verification. It never fakes a result. See docs/EKYC.md.
#
# None of these may use the NEXT_PUBLIC_ prefix: they are server-side secrets
# and must never be bundled into client JavaScript.

# Provider code. Leave as "unconfigured" until a real adapter is registered in
# src/lib/ekyc/provider.ts.
EKYC_PROVIDER="unconfigured"

# Base URL of the provider's API, exactly as their documentation states.
EKYC_API_BASE_URL=""

# OAuth-style client credentials, if the provider uses them.
EKYC_CLIENT_ID=""
EKYC_CLIENT_SECRET=""

# Single API key, for providers that use one instead of client credentials.
EKYC_API_KEY=""

# Absolute URL the provider redirects the candidate's browser back to. Must
# match the URL registered with the provider.
EKYC_REDIRECT_URI="http://localhost:3000/api/ekyc/callback"

# Optional server-to-server notification URL, for providers that POST results
# to a webhook rather than relying on the browser redirect.
EKYC_CALLBACK_URI=""

# Shared secret used to verify the provider's webhook signature/HMAC. Keep it
# separate from EKYC_API_KEY so rotating one does not invalidate the other.
EKYC_WEBHOOK_SECRET=""

# --- UIDAI Paperless Offline e-KYC Public Certificate ---------------------
# Path to the authentic official UIDAI public key certificate file (.cer / .pem / .crt / .der)
# downloaded from https://myaadhaar.uidai.gov.in / https://uidai.gov.in.
# Place your certificate in `./certs/` (git-ignored) outside public web directories.
# Leave unset or empty until a valid official UIDAI certificate is supplied.
UIDAI_OFFLINE_CERT_PATH="./certs/uidai_offline_publickey.cer"

# Alternatively, provide the full PEM certificate string directly:
UIDAI_OFFLINE_CERT_PEM=""

# ---------------------------------------------------------------------------
# Module 5 - document storage
# ---------------------------------------------------------------------------
# Optional. Where uploaded supporting documents (PDF/JPG/PNG) are written.
# Defaults to ./storage/documents when unset. The directory is git-ignored and
# never served statically: files are readable only through the authenticated
# download routes after an ownership / role check.
DOCUMENT_STORAGE_DIR=""

# ---------------------------------------------------------------------------
# Module 7 & 8 - Admin Electronic Signature & Certificate Storage
# ---------------------------------------------------------------------------
# Storage directory for Admin electronic signature images.
ADMIN_SIGNATURE_STORAGE_DIR="./storage/admin-signatures"

# Configured Administrator email for signature review requests.
ADMIN_SIGNING_EMAIL=""

# Expiry duration for email signing tokens in hours (default: 24).
ADMIN_SIGNING_TOKEN_TTL_HOURS="24"

# Where generated PDF certificates are written.
# Defaults to ./storage/certificates when unset.
CERTIFICATE_STORAGE_DIR=""

# ---------------------------------------------------------------------------
# Email Notifications & OTP Delivery (Gmail / SMTP)
# ---------------------------------------------------------------------------
# To deliver real OTP emails to Gmail, enable email notifications and provide
# your Gmail address and 16-character Google App Password:
# (Generate App Password at: https://myaccount.google.com/apppasswords)
#
# EMAIL_NOTIFICATIONS_ENABLED="true"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="your-email@gmail.com"
EMAIL_NOTIFICATIONS_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@skillcert.gov.in"


